{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HL7Extract Configuration",
  "type": "object",
  "required": ["version", "output"],
  "unevaluatedProperties": false,
  "properties": {
    "version": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "required": ["enabled", "destinations"],
      "unevaluatedProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "destinations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/terminalDestination" },
              { "$ref": "#/$defs/csvDestination" },
              { "$ref": "#/$defs/networkDestination" }
            ]
          }
        }
      }
    },
    "ai": {
      "type": "object",
      "required": ["enabled"],
      "unevaluatedProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "provider": {
          "type": "string",
          "enum": ["openai"]
        },
        "model": {
          "type": "string"
        },
        "use_on": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "raw_message",
              "extracted_elements",
              "formatted_output"
            ]
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "summarize",
              "classify",
              "detect_missing_fields",
              "explain_message",
              "extract_insights"
            ]
          }
        },
        "send_phi": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {

		"terminalDestination": {
		  "type": "object",
		  "required": ["type", "enabled", "format"],
		  "additionalProperties": false,
		  "properties": {
		    "type": { "const": "terminal" },
		    "enabled": { "type": "boolean" },
		    "format": {
		      "type": "string",
		      "enum": ["key_value", "extracted_elements", "json", "csv_row", "raw"]
		    }
		  }
		}, 

		"csvDestination": {
		  "type": "object",
		  "required": ["type", "enabled", "format", "path"],
		  "additionalProperties": false,
		  "properties": {
		    "type": { "const": "csv" },
		    "enabled": { "type": "boolean" },
		    "format": {
		      "type": "string",
		      "enum": ["key_value", "extracted_elements", "json", "csv_row", "raw"]
		    },
		    "path": { "type": "string" },
		    "include_header": { "type": "boolean" },
		    "append": { "type": "boolean" }
		  }
		},

		"networkDestination": {
		  "type": "object",
		  "required": ["type", "enabled", "format", "host", "port", "protocol"],
		  "additionalProperties": false,
		  "properties": {
		    "type": { "const": "network" },
		    "enabled": { "type": "boolean" },
		    "format": {
		      "type": "string",
		      "enum": ["key_value", "extracted_elements", "json", "csv_row", "raw"]
		    },
		    "host": { "type": "string" },
		    "port": {
		      "type": "integer",
		      "minimum": 1,
		      "maximum": 65535
		    },
		    "protocol": {
		      "type": "string",
		      "enum": ["tcp", "udp"]
		    }
		  }
		}  

  }
}
